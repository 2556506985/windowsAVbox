{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebHomeTV Desktop",
  "version": "0.1.0",
  "identifier": "com.silent.webhtv.desktop",
  "build": {
    "beforeDevCommand": "npm run java:fetch && npm run java:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run java:fetch && npm run java:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebHomeTV Desktop",
        "width": 1360,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#111310"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http: ws://localhost:1420; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/mpv/**/*",
      "resources/java-runtime/**/*",
      "resources/java-spider-sidecar-0.1.0.jar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
